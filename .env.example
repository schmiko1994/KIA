# Application
APP_NAME="TikTok Automation System"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./tiktok_automation.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/tiktok_automation

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# LLM / OpenAI
LLM_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4-turbo-preview
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# ToTo Service
TOTO_API_URL=http://localhost:7860
TOTO_API_KEY=
TOTO_TIMEOUT=300

# ComfyUI Service
COMFYUI_API_URL=http://localhost:8188
COMFYUI_TIMEOUT=600

# TikTok Upload
TIKTOK_HEADLESS=false
TIKTOK_UPLOAD_TIMEOUT=300
TIKTOK_MAX_RETRIES=3

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=524288000
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION_DAYS=30

# Workers
ENABLE_UPLOAD_WORKER=true
ENABLE_METRICS_WORKER=true
UPLOAD_WORKER_INTERVAL=60
METRICS_WORKER_INTERVAL=300

# Scheduler
SCHEDULER_MAX_RETRIES=3
SCHEDULER_RETRY_DELAY=300

# Proxy
PROXY_HEALTH_CHECK_INTERVAL=600
PROXY_TIMEOUT=30

# Notifications (Optional)
WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Metrics
METRICS_COLLECTION_ENABLED=true
METRICS_RETENTION_DAYS=90
